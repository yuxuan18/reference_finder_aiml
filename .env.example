# Collection CLIs load this project's .env; exported variables take precedence.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Used for OpenAI paper/query embeddings. Keep this file's real values in .env.
OPENAI_API_KEY=
# Optional authorized OpenReview API access token; never put this in a URL.
OPENREVIEW_TOKEN=
# Alternatively, log in once per API host with your OpenReview account.
# Put username and password on separate lines. Quote values containing spaces/#.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
